[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "BIGpopA"]
	path = BIGpopA
	url = https://github.com/breeding-insight/bigpopa
[submodule "BIGr"]
	path = BIGr
	url = https://github.com/breeding-insight/bigr
[submodule "Familia"]
	path = Familia
	url = https://github.com/breeding-insight/familia
[submodule "deltabreedquery"]
	path = deltabreedquery
	url = https://github.com/breeding-insight/deltabreedquery
[submodule "viewpoly"]
	path = viewpoly
	url = https://github.com/breeding-insight/viewpoly
